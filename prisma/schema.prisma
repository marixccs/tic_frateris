generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StatusMembro {
  ATIVO
  INATIVO
  INATIVO_TEMPORARIAMENTE
}

model Membro {
  id             Int          @id @default(autoincrement())
  nome           String
  dataNascimento DateTime     @db.Date
  cpf            String
  observacao     String?
  statusMembro   StatusMembro
  dataIngresso   DateTime     @db.Date
  grupoId Int?
  grupo   Grupo? @relation(fields: [grupoId], references: [id])
}

enum StatusGrupo {
  ATIVO
  INATIVO
}

model Grupo {
  id          Int         @id @default(autoincrement())
  nome        String      @unique
  descricao   String?
  statusGrupo StatusGrupo @default(ATIVO)
  membros     Membro[]
}